# echo "($(date +"%Y-%m-%d, %H:%M:%S")) Loading .zshrc"

# ─── SSH Keychain Unlock ────────────────────────────────────────────────────────
# SSH sessions can't read the login keychain while locked (Claude Code shows
# "Not logged in"). Prompt to unlock once; the -w secret read fails while
# locked (metadata reads succeed even then), so no prompt when already
# unlocked. Must stay above the instant-prompt block: it requires console
# input.
if [[ -n "$SSH_CONNECTION" ]] && ! security find-generic-password -s "Claude Code-credentials" -w >/dev/null 2>&1; then
  security unlock-keychain ~/Library/Keychains/login.keychain-db
fi

# ─── Instant Prompt ─────────────────────────────────────────────────────────────
# Must stay at the top. Any code requiring console input goes ABOVE this block.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ─── Oh My Zsh Configuration ────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"

# https://stackoverflow.com/questions/62931101/i-have-multiple-files-of-zcompdump-why-do-i-have-multiple-files-of-these
export ZSH_COMPDUMP="$ZSH/cache/.zcompdump-$HOST"

# Case-sensitive completion must be off. _ and - will be interchangeable.
HYPHEN_INSENSITIVE="true"

# zstyle ':omz:update' mode disabled  # disable automatic updates
# zstyle ':omz:update' mode auto      # update automatically without asking
zstyle ':omz:update' mode reminder    # just remind me to update when it's time
zstyle ':omz:update' frequency 13

COMPLETION_WAITING_DOTS="true"

# Uncomment to disable marking untracked files as dirty (faster for large repos)
# DISABLE_UNTRACKED_FILES_DIRTY="true"

# "mm/dd/yyyy"|"dd.mm.yyyy"|"yyyy-mm-dd" or strftime format
HIST_STAMPS="yyyy-mm-dd"

# Conditional plugin loading: minimal set for Claude Code
if [[ -z "$CLAUDECODE" ]]; then
  # Full plugin list for normal shell
  plugins=(
    fzf-tab gitfast ls cd-ls copypath copybuffer command-not-found
    autoupdate macos zsh-autosuggestions fast-syntax-highlighting asdf
    alias-tips git-it-on catimg isodate colored-man-pages
    dircycle auto-notify autoswitch_virtualenv
  )
  # temporarily removed: safe-paste
  # replaced: git with gitfast
else
  # Essential plugins for Claude Code
  plugins=(gitfast command-not-found asdf)
fi

ZSH_THEME=""  # using homebrew p10k, not OMZ theme

# ─── Environment (needed by PATH) ───────────────────────────────────────────────
export PNPM_HOME="$HOME/Library/pnpm"              # pnpm
export ANDROID_HOME="$HOME/Library/Android/sdk"   # android
export OLLAMA_ORIGINS="*"
export OLLAMA_MAX_LOADED_MODELS=1      # 32 GB: one model resident at a time
export OLLAMA_KEEP_ALIVE=1h            # stay loaded between prompts
export OLLAMA_CONTEXT_LENGTH=32768     # 256K advertised; KV cache for more does not fit

# Perl local::lib
export PERL5LIB="$HOME/perl5/lib/perl5${PERL5LIB:+:$PERL5LIB}"
export PERL_LOCAL_LIB_ROOT="$HOME/perl5${PERL_LOCAL_LIB_ROOT:+:$PERL_LOCAL_LIB_ROOT}"
export PERL_MB_OPT="--install_base \"$HOME/perl5\""
export PERL_MM_OPT="INSTALL_BASE=$HOME/perl5"

# ─── PATH ───────────────────────────────────────────────────────────────────────
# Deduplicate PATH entries automatically
typeset -U PATH path

# Go environment (sets GOBIN, etc.)
[[ -f "$HOME/.asdf/plugins/golang/set-env.zsh" ]] && source "$HOME/.asdf/plugins/golang/set-env.zsh"

# JAVA_HOME follows the JDK a project pins in .tool-versions. It only speaks up
# where asdf resolves a java, so a machine JAVA_HOME set below stays the default.
[[ -f "$HOME/.asdf/plugins/java/set-java-home.zsh" ]] && source "$HOME/.asdf/plugins/java/set-java-home.zsh"

# Dotnet root for tooling (avoid "." / empty)
DOTNET_ROOT=""
if command -v asdf >/dev/null 2>&1; then
  dotnet_path="$(asdf which dotnet 2>/dev/null)" || dotnet_path=""
  [[ -n "$dotnet_path" ]] && export DOTNET_ROOT="${dotnet_path:h}"   # :h = dirname in zsh
fi

# Only include optional paths if they're non-empty
path=(
  "/opt/homebrew/opt/coreutils/libexec/gnubin"                # gnubin
  "$HOME/.asdf/shims"                                         # asdf
  "$HOME/.dotnet/tools"                                       # dotnet tools
  ${GOBIN:+"$GOBIN"}                                          # go
  ${PNPM_HOME:+"$PNPM_HOME"}                                  # pnpm (v10 global bins)
  ${PNPM_HOME:+"$PNPM_HOME/bin"}                              # pnpm (v11+ global bins)
  "$HOME/.cache/lm-studio/bin"                                # lm studio cli
  ${ANDROID_HOME:+"$ANDROID_HOME/platform-tools"}             # android
  "$HOME/perl5/bin"                                           # perl
  ${DOTNET_ROOT:+"$DOTNET_ROOT"}                              # dotnet
  "$HOME/bin"
  "$HOME/.local/bin"
  "/usr/local/bin"
  $path
)

# Regenerate asdf shims (set ASDF_RESHIM_ON_START=1 to enable, for A/B testing)
if command -v asdf >/dev/null 2>&1; then
  [[ -n "$ASDF_RESHIM_ON_START" ]] && asdf reshim
fi

# ─── Source Oh My Zsh ───────────────────────────────────────────────────────────
# compinit is inside this script
source "$ZSH/oh-my-zsh.sh"

# ─── Environment (post-OMZ) ─────────────────────────────────────────────────────
unalias _ 2>/dev/null  # OMZ sets _='sudo'; prefer explicit sudo
# Preferred editor for local and remote sessions
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='nano'
elif (( $+commands[subl] )); then
  export EDITOR='subl --wait'
elif (( $+commands[code] )); then
  export EDITOR='code --wait'   # a work profile machine may not carry Sublime
else
  export EDITOR='nano'
fi

# history size fix
export HISTSIZE=99999
export SAVEHIST=$HISTSIZE

# ─── agents-shared ──────────────────────────────────────────────────────────────
# $AGENTS_SHARED and $DEV_ROOT, written by agents-shared/scripts/init-global.sh from
# the checkout's own location. Skills invoke scripts through these instead of a baked
# path. The file is absent until that script has run on this machine.
[[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/agents-shared/env.zsh" ]] && source "${XDG_CONFIG_HOME:-$HOME/.config}/agents-shared/env.zsh"

# ─── atlas ──────────────────────────────────────────────────────────────────────
# The per-repo patterns saying which files are documents, for atlas's document
# manager. Setting it also says this machine files documents at all: /new-repo
# offers to add a section for a new repo only when it is set.
[[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/atlas/atlasinclude" ]] && export ATLAS_INCLUDE="${XDG_CONFIG_HOME:-$HOME/.config}/atlas/atlasinclude"

# ─── Tool Initialization ────────────────────────────────────────────────────────
# Powerlevel10k theme
source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ -f "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"

# https://github.com/junegunn/fzf?tab=readme-ov-file#setting-up-shell-integration
command -v fzf >/dev/null 2>&1 && source <(fzf --zsh)

# clo (agents-shared) — wraps it so the terminal is left in the folder it launched Claude in
command -v clo >/dev/null 2>&1 && eval "$(clo --init zsh)"

# Homebrew command-not-found handler
HOMEBREW_COMMAND_NOT_FOUND_HANDLER="$(brew --repository)/Library/Homebrew/command-not-found/handler.sh"
[ -f "$HOMEBREW_COMMAND_NOT_FOUND_HANDLER" ] && source "$HOMEBREW_COMMAND_NOT_FOUND_HANDLER"

# keep at bottom - https://github.com/romkatv/powerlevel10k/issues/1554
unset ZSH_AUTOSUGGEST_USE_ASYNC

# ─── Functions ──────────────────────────────────────────────────────────────────
# list preferred Wi-Fi networks
function get_wifi_networks() {
  local wifi_networks
  wifi_networks=$(networksetup -listpreferredwirelessnetworks en0) || {
    echo "Failed to retrieve Wi-Fi network list."
    return 1
  }
  echo "$wifi_networks" | sed -e 's/^ *//'
}

# send macos notification if prompted for assword
function notify_on_password_prompt() {
  local cmd="${1//\"/\\\"}"
  if [[ "$cmd" =~ "assword" ]]; then
    osascript -e "display notification \"cmd: $cmd\" with title \"password needed\""
  fi
}

# benchmark zshrc load time
# usage: zshrc_bench [-v] [runs] [warmup] [file]
# examples:
#   zshrc_bench              # 10 runs, 1 warmup
#   zshrc_bench 30           # 30 runs
#   zshrc_bench 30 3         # 30 runs, 3 warmup
#   zshrc_bench -v 20 2      # verbose per-run output
#   zshrc_bench 20 2 ~/.zshrc.new   # explicit file
# A/B test asdf reshim:
#   zshrc_bench 20 2
#   ASDF_RESHIM_ON_START=1 zshrc_bench 20 2
function zshrc_bench() {
  emulate -L zsh
  setopt localoptions no_aliases pipefail

  local verbose=0
  if [[ "$1" == "-v" ]]; then
    verbose=1
    shift
  fi

  local runs=${1:-10}
  local warmup=${2:-1}
  local file=${3:-$HOME/.zshrc}

  if (( runs < 1 || warmup < 0 || warmup >= runs )); then
    echo "usage: zshrc_bench [-v] [runs>=1] [warmup>=0<runs] [file]"
    return 2
  fi
  [[ -f "$file" ]] || { echo "file not found: $file"; return 2; }

  local -a times
  local i out ms rc

  local cmd='
    zmodload zsh/datetime
    t0=$EPOCHREALTIME
    source "$ZSHRC_BENCH_FILE" >/dev/null 2>&1
    rc=$?
    t1=$EPOCHREALTIME
    printf "%.0f %d\n" $(( (t1 - t0) * 1000.0 )) $rc
  '

  # warmup (ignored)
  for (( i = 1; i <= warmup; i++ )); do
    ZSHRC_BENCH_FILE="$file" zsh -i -f -c "$cmd" >/dev/null
  done

  # measured runs
  for (( i = 1; i <= runs; i++ )); do
    out=$(ZSHRC_BENCH_FILE="$file" zsh -i -f -c "$cmd")
    ms=${out%% *}
    rc=${out##* }
    times+=("$ms")

    if (( verbose )); then
      printf "run %2d: %4d ms  rc=%d\n" $i $ms $rc
    fi

    if (( rc != 0 )); then
      printf "warning: source returned rc=%d on run %d\n" $rc $i >&2
    fi
  done

  # stats
  local -a sorted
  sorted=("${(@on)times}")
  local sum=0
  for ms in "${times[@]}"; do (( sum += ms )); done

  local n=${#times}
  local min=${sorted[1]}
  local max=${sorted[-1]}
  local avg=$(( sum / n ))

  local median
  if (( n % 2 == 1 )); then
    median=${sorted[$(( (n+1)/2 ))]}
  else
    median=$(( (sorted[n/2] + sorted[n/2+1]) / 2 ))
  fi

  local p95_idx=$(( (95*n + 99) / 100 ))
  local p95=${sorted[$p95_idx]}

  echo "zshrc_bench: $file  runs=$n  warmup=$warmup  (ms)"
  echo "min=$min  median=$median  avg=$avg  p95=$p95  max=$max"
}

# pnpm majors keep separate global roots (global/5 → global/v11 → …) and never
# migrate them: after a version bump the new root starts empty while the old
# root's bins keep working from PATH, so `pnpm update -g` silently updates
# nothing. This reinstalls the old root's packages into the current one (carrying
# over build-script approvals), then removes the old root and its stale bin
# scripts. No-op when the current root already has packages or no old root exists.
_pnpm-migrate-globals() {
  command -v node >/dev/null || return 0
  local pnpm_home="${PNPM_HOME:-$HOME/Library/pnpm}"
  local cur_root old_root r
  cur_root="$(pnpm root -g 2>/dev/null)" || return 0
  [[ "$cur_root" == */node_modules ]] && cur_root="${cur_root%/node_modules}"

  # Manifests live at <root>/package.json (pnpm ≤10) or <root>/<hash>/package.json (≥11)
  local -a cur_manifests old_manifests
  cur_manifests=("$cur_root"/package.json(N) "$cur_root"/*/package.json(N))
  (( ${#cur_manifests} )) && return 0   # current root already populated

  # Newest other root that has manifests
  for r in "$pnpm_home"/global/*(N/om); do
    [[ "$r" == "$cur_root" ]] && continue
    old_manifests=("$r"/package.json(N) "$r"/*/package.json(N))
    (( ${#old_manifests} )) && { old_root="$r"; break }
  done
  [[ -z "$old_root" ]] && return 0

  local -a pkgs allow allow_flags
  pkgs=(${(f)"$(node -p '[...new Set(process.argv.slice(1).flatMap(p=>Object.keys(require(p).dependencies||{})))].join("\n")' $old_manifests 2>/dev/null)"})
  (( ${#pkgs} )) || return 0

  # Build approvals: pnpm ≤10 keeps them in package.json, ≥11 in pnpm-workspace.yaml
  allow=(${(f)"$(node -p '[...new Set(process.argv.slice(1).flatMap(p=>(require(p).pnpm||{}).onlyBuiltDependencies||[]))].join("\n")' $old_manifests 2>/dev/null)"})
  if [[ -f "$old_root/pnpm-workspace.yaml" ]]; then
    allow+=(${(f)"$(awk '/^allowBuilds:/{f=1;next} f&&/^[^ ]/{f=0} f&&/^  [^ ]+: true/{sub(/:.*/,"");sub(/^  /,"");print}' "$old_root/pnpm-workspace.yaml")"})
  fi
  allow=(${(u)allow})
  local a; for a in $allow; do allow_flags+=("--allow-build=$a"); done

  echo "==> pnpm: migrating global packages from ${old_root:t} to $(pnpm --version): $pkgs"
  pnpm add -g $allow_flags $pkgs || { echo "pnpm global migration failed; old root left untouched"; return 1 }

  # --allow-build is one-shot; persist approvals or the next `pnpm update -g` prompts interactively
  if (( ${#allow} )); then
    local ws="$cur_root/pnpm-workspace.yaml"
    grep -q '^allowBuilds:' "$ws" 2>/dev/null || print "allowBuilds:" >> "$ws"
    for a in $allow; do
      grep -q "^  $a: true" "$ws" || print "  $a: true" >> "$ws"
    done
  fi

  # Remove wrapper scripts pointing into the old root, then the root itself
  local f
  for f in "$pnpm_home"/*(N.); do
    grep -q "global/${old_root:t}/" "$f" 2>/dev/null && rm -f "$f"
  done
  rm -rf "$old_root"
}

_pnpm-global-manifests() {
  local root; root="$(pnpm root -g 2>/dev/null)" || return 0
  root="${root%/node_modules}"
  print -l -- "$root"/package.json(N) "$root"/*/package.json(N)
}

# True when a global bin wrapper points at a file that no longer exists, or
# when globals are installed but no wrappers are. Each wrapper records its
# target on a `# cmd-shim-target=` line.
_pnpm-shims-broken() {
  local -a manifests wrappers
  manifests=(${(f)"$(_pnpm-global-manifests)"})
  (( ${#manifests} )) || return 1
  local bindir; bindir="$(pnpm bin -g 2>/dev/null)" || return 0
  wrappers=("$bindir"/*(N.))
  (( ${#wrappers} )) || return 0
  local w target
  for w in $wrappers; do
    target="$(sed -n 's/^# cmd-shim-target=//p' "$w")"
    [[ -n "$target" && -e "$target" ]] || return 0
  done
  return 1
}

# A peer-dep bump renames the .pnpm directory and the $PNPM_HOME wrappers stop
# resolving. `pnpm install -g` short-circuits on an up-to-date lockfile without
# re-linking; `pnpm add -g` re-links, so re-add each global at its recorded spec.
_pnpm-fix-shims() {
  _pnpm-shims-broken || return 0
  local -a manifests pkgs
  manifests=(${(f)"$(_pnpm-global-manifests)"})
  pkgs=(${(f)"$(node -p '[...new Set(process.argv.slice(1).flatMap(p => Object.entries(require(p).dependencies || {}).map(([n, v]) => n + "@" + v)))].join("\n")' $manifests 2>/dev/null)"})
  echo "==> pnpm: re-linking global bin wrappers"
  (( ${#pkgs} )) && pnpm add -g $pkgs
}

# pnpm ≥11 installs each global update into a fresh directory and deletes the
# old one, so a running happy daemon is left executing deleted files and can no
# longer spawn sessions. Restart it only when it has no sessions; with sessions
# active, leave it running and flag it for later.
_happy-daemon-refresh() {
  command -v happy >/dev/null || return 0
  local pid entry
  pid="$(pgrep -f 'happy/dist/index.mjs daemon start-sync' | head -1)"
  [[ -n "$pid" ]] || return 0
  entry="$(ps -o command= -p "$pid" | grep -o '/[^ ]*/happy/dist/index.mjs')"
  [[ -e "$entry" ]] && return 0
  if happy daemon list 2>/dev/null | grep -q 'No active sessions'; then
    echo "==> happy: restarting daemon, its install was replaced"
    happy daemon stop && happy daemon start
  else
    echo "Action needed: happy daemon runs from a replaced install and has active sessions;" \
      "once they finish: happy daemon stop && happy daemon start"
  fi
}

# Casks leave com.apple.quarantine on every app they install, so each upgrade
# brings back the "downloaded from the internet" prompt on first launch. Clear
# it only where Gatekeeper already accepts the app as notarized; anything else
# keeps the flag and stays blocked.
_unquarantine-notarized-casks() {
  local app
  for app in /Applications/*.app(N/) "$HOME"/Applications/*.app(N/); do
    xattr -p com.apple.quarantine "$app" 2>/dev/null | grep -q 'Homebrew' || continue
    spctl -a -t exec -vv "$app" 2>&1 | grep -q '^source=Notarized Developer ID' || continue
    xattr -dr com.apple.quarantine "$app" && echo "unquarantined ${app:t}"
  done
}

# Plugin repos move rarely; pulling all six on every run cost half of a no-op
# run. Refresh at most once a day (UPDATE_ALL_FORCE=1 overrides).
_update-all-asdf-plugins() {
  setopt local_options extended_glob
  local stamp="${XDG_CACHE_HOME:-$HOME/.cache}/update-all/asdf-plugins.stamp"
  if [[ -z "${UPDATE_ALL_FORCE:-}" ]] && [[ -n $stamp(#qN.mh-24) ]]; then
    echo "asdf plugins refreshed within 24h, skipping"
    return 0
  fi
  asdf plugin update --all || return 1
  mkdir -p "${stamp:h}" && touch "$stamp"
}

# Whether an Apple ID is signed in to the App Store: an active, authenticated iTunesStore account
# in macOS's Accounts database (a count only). 0 signed in, 1 signed out, 2 unreadable: macOS
# privacy protection blocks the file unless the terminal has Full Disk Access, and an unreadable
# login is not a signed-out one.
_mas-signed-in() {
  local db="$HOME/Library/Accounts/Accounts4.sqlite" n
  [[ -r "$db" ]] || return 2
  n=$(sqlite3 -readonly "$db" "SELECT count(*) FROM ZACCOUNT a JOIN ZACCOUNTTYPE t ON a.ZACCOUNTTYPE = t.Z_PK
      WHERE t.ZIDENTIFIER = 'com.apple.account.iTunesStore' AND a.ZACTIVE = 1 AND a.ZAUTHENTICATED = 1;" 2>/dev/null) || return 2
  (( ${n:-0} > 0 ))
}

# One update-all stage. Runs from $HOME: global pnpm and asdf state resolve
# against the cwd's version pins, so a project's packageManager must not pick them.
# HEAD of every custom plugin/theme repo, to tell whether an update changed anything.
_update-all-custom-heads() {
  local d
  find -L "$ZSH_CUSTOM" -maxdepth 3 -name .git | sort | while IFS= read -r d; do
    print -r -- "$d $(git -C "${d:h}" rev-parse HEAD 2>/dev/null)"
  done
}

# The question a stage is waiting on, read from its log: the last non-blank line, printed when it
# asks for YES/NO, y/n or a password. Prints nothing and returns 1 otherwise.
_update-all-pending-question() {
  local line
  line=$(tail -c 600 -- "$1" 2>/dev/null | LC_ALL=C sed -e $'s/\x1b\\[[0-9;?]*[A-Za-z]//g' -e $'s/\r//g' \
    | LC_ALL=C grep -v '^[[:space:]]*$' | tail -n 1)
  print -r -- "$line" | LC_ALL=C grep -E '\(Enter YES or NO\)|Please enter YES or NO|\[[Yy]/[Nn]\]|[Pp]assword[^:]*:[[:space:]]*$'
}

# Runs beside a stage until killed: one macOS notification each time the stage stops at a question.
_update-all-watch-for-question() {
  local log=$1 stage=$2 asked=0 question
  while sleep 2; do
    if ! question=$(_update-all-pending-question "$log"); then
      asked=0
    elif (( ! asked )); then
      asked=1
      if (( $+commands[terminal-notifier] )); then
        terminal-notifier -title "update-all is waiting" -message "$stage asks: $question" >/dev/null 2>&1
      else
        osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title "update-all is waiting"' \
          -e 'end run' "$stage asks: $question" >/dev/null 2>&1
      fi
    fi
  done
}

# After Ctrl-C in a stage: s skips it and goes on; any other key, a second Ctrl-C, or no
# terminal quits.
_update-all-ask-skip() {
  setopt local_options local_traps
  [[ -t 0 ]] || return 1
  trap 'return 1' INT
  local key
  read -k 1 "key?==> Interrupted during $1. s = skip it and go on, any other key = quit: " || return 1
  print
  [[ $key == [sS] ]]
}

# `brew upgrade`, repeated after reinstalling a cask whose install receipt names an app
# that is gone (brew: "It seems the App source '...' is not there"): a reinstall forces the
# uninstall and skips the missing app. Each cask is reinstalled once per run.
# brew runs under its own `script`, so its output is saved for that check while it still writes
# to a terminal: through a pipe, a formula's licence question stays in brew's output buffer and
# the run hangs on an invisible prompt. --no-ask: on a terminal brew would otherwise confirm
# every upgrade. Returns 130 on Ctrl-C (`script` reports a signal death as its number, 2).
_update-all-brew-upgrade() {
  local out rc token
  local -a fixed=()
  out=$(mktemp) || return 1
  while :; do
    script -q -F "$out" brew upgrade --no-ask
    rc=$?
    (( rc == 2 || rc == 130 )) && { rc=130; break; }
    (( rc )) || break
    token=$(LC_ALL=C sed -e $'s/\x1b\\[[0-9;?]*[A-Za-z]//g' -e $'s/\r//g' "$out" \
      | sed -n "s/^.*Error: \([^:]*\): It seems the App source .* is not there.*/\1/p" | head -n 1)
    [[ -n $token && ${fixed[(Ie)$token]} == 0 ]] || break
    fixed+=($token)
    print -P "%B==> $token: receipt names an app that is gone, reinstalling%b"
    brew reinstall --cask "$token" || { rc=$?; break; }
  done
  command rm -f -- "$out"
  return $rc
}

# Spotify overwrites spicetify's patch when it updates itself, and a new spicetify
# build needs the patch redone: re-apply only when either version differs from the pair
# last applied. On macOS the terminal needs App Management permission to edit Spotify.app.
_update-all-spicetify-reapply() {
  local app=/Applications/Spotify.app stamp="${XDG_CACHE_HOME:-$HOME/.cache}/update-all/spicetify-applied" now
  [[ -d $app ]] || { echo "Spotify.app not installed, skipping"; return 0; }
  now="$(defaults read "$app/Contents/Info" CFBundleShortVersionString) $(spicetify --version)"
  if [[ -f $stamp && "$(<$stamp)" == "$now" ]]; then
    echo "spicetify already applied to Spotify ${now% *} (spicetify ${now#* })"
    return 0
  fi
  # restore fails when Spotify is already stock and its backup is outdated; backup apply fixes that
  if ! spicetify restore backup apply && ! spicetify backup apply; then
    echo "Error: spicetify apply failed; if it reports a file not found, allow this terminal under Settings > Privacy & Security > App Management and rerun"
    return 1
  fi
  mkdir -p "${stamp:h}" && print -r -- "$now" >| "$stamp"
}

# `mas upgrade`, minus the apps the App Store refused on an earlier run. For some apps the App
# Store will not start an update that mas asks for: it shows an Apple ID error popup for each,
# and mas prints "No downloads initiated for ADAM ID <id>" (Keynote, Numbers and Pages, Nov
# 2026). Its own Updates page updates them after a sign-in. A refused app is recorded with its
# installed version and left out of later runs, so no run opens those popups again, until its
# version changes (updated in the App Store) or a newer release arrives, and it is tried again.
_update-all-mas-upgrade() {
  local state="${XDG_CACHE_HOME:-$HOME/.cache}/update-all/mas-refused"
  local row='^ *([0-9]+) +(.*[^ ]) +\(([^ ]+) -> ([^)]+)\)' refusal='No downloads initiated for ADAM ID ([0-9]+)'
  local line id ver err rc=0 other=0
  local -A refused name have want
  local -a todo held refused_now ask names
  if [[ -f $state ]]; then
    while IFS=$'\t' read -r id ver; do [[ -n $id ]] && refused[$id]=$ver; done < "$state"
  fi
  # "361309726  Pages  (15.1.1 -> 16.0)": a refusal holds while both versions are unchanged
  for line in ${(f)"$(mas outdated 2>/dev/null)"}; do
    [[ $line =~ $row ]] || continue
    id=$match[1]; name[$id]=$match[2]; have[$id]=$match[3]; want[$id]=$match[4]
    if [[ ${refused[$id]-} == "$match[3] $match[4]" ]]; then held+=($id); else todo+=($id); fi
  done
  if (( ! ${#todo} && ! ${#held} )); then
    echo "mas: nothing to upgrade"
    return 0
  fi
  if (( ${#todo} )); then
    err=$(mktemp) || return 1
    mas upgrade $todo 2>"$err"; rc=$?
    for line in ${(f)"$(<$err)"}; do
      if [[ $line =~ $refusal ]]; then refused_now+=($match[1])
      else print -r -- "$line" >&2; other=1; fi
    done
    command rm -f -- "$err"
    # every error was a refusal: the stage did what mas can do, the rest is the Action needed line
    (( rc && ! other && ${#refused_now} )) && rc=0
  fi
  ask=($held $refused_now)
  mkdir -p "${state:h}"
  : >| "$state"
  for id in $ask; do print -r -- "$id"$'\t'"${have[$id]} ${want[$id]}" >> "$state"; done
  if (( ${#ask} )); then
    for id in $ask; do names+=("${name[$id]:-$id}"); done
    print -r -- "Action needed: the App Store will not update ${(j:, :)names} through mas (it shows an Apple ID error popup instead). Update them from App Store > Updates, signing in when it asks; uall leaves them out until their version changes."
  fi
  return $rc
}

_update-all-stage() {
  cd "$HOME" || return 1
  case "$1" in
    brew) brew update && _update-all-brew-upgrade && _update-all-upgrade-manual-update-casks && _unquarantine-notarized-casks ;;
    pnpm) _pnpm-migrate-globals && pnpm update -g && _pnpm-fix-shims && _happy-daemon-refresh ;;
    asdf) _update-all-asdf-plugins && _update-all-bump-asdf-pins ;;
    uv)   uv tool upgrade --all ;;
    mas)
      # Without an App Store account, mas tries the preinstalled Apple apps and the App Store
      # opens a sign-in window (ISErrorDomain -128). Same check as import.sh step 20.
      # mas 7 upgrades through sudo ("Requires root privileges"); `mas outdated` does not. The stage
      # runs under `script`, whose pty hides whether update-all had a terminal, so update-all
      # decides that and passes UPDATE_ALL_MAS_SUDO=1 when a password prompt can be answered.
      # A skip exits 78, which the summary shows as "skipped", never "ok".
      local signed_in=0; _mas-signed-in || signed_in=$?
      if (( signed_in == 2 )); then
        echo "Action needed: this terminal cannot read the App Store login (macOS privacy protection). Give it Full Disk Access (System Settings > Privacy & Security > Full Disk Access), reopen it and rerun, or run mas upgrade yourself"
        return 78
      elif (( signed_in == 1 )); then
        echo "no App Store account signed in: mas skipped"
        return 78
      elif (( ! ${UPDATE_ALL_MAS_SUDO:-0} )) && [[ -n "$(mas outdated 2>/dev/null)" ]]; then
        echo "Action needed: mas upgrades need the sudo password and this shell has no terminal; run mas upgrade in a terminal"
        return 78
      else
        _update-all-mas-upgrade
      fi ;;
    spicetify) _update-all-spicetify-reapply ;;
    local-builds) _update-all-local-builds ;;
    omz)
      # OMZ core, the same call and stamp as `omz update`, so its session-start reminder goes quiet.
      # Skipped within ':omz:update' frequency days; frequency, verbose and cooldown are read in
      # update-all and passed in as OMZ_UPDATE_DAYS/_VERBOSE/_COOLDOWN (this shell reads no zstyles).
      local stamp="${ZSH_CACHE_DIR:-$HOME/.cache/oh-my-zsh}/.zsh-update" LAST_EPOCH=0 EXIT_STATUS=
      [[ -f $stamp ]] && . "$stamp"
      if [[ -z "${UPDATE_ALL_FORCE:-}" && -z "$EXIT_STATUS" ]] && (( EPOCHSECONDS / 86400 - ${LAST_EPOCH:-0} < ${OMZ_UPDATE_DAYS:-13} )); then
        echo "oh-my-zsh core checked within ${OMZ_UPDATE_DAYS:-13} days, skipping"
        return 0
      fi
      local cooldown=${OMZ_UPDATE_COOLDOWN:-0} head_before=$(git -C "$ZSH" rev-parse HEAD 2>/dev/null)
      [[ $cooldown == <-> ]] || cooldown=0
      # One ls-remote call settles "nothing new" without a fetch (a cooldown needs the full path)
      if (( cooldown == 0 )); then
        local branch=${"$(git -C "$ZSH" config --local oh-my-zsh.branch)":-master}
        local remote=${"$(git -C "$ZSH" config --local oh-my-zsh.remote)":-origin}
        local remote_head=$(git -C "$ZSH" ls-remote "$remote" "refs/heads/$branch" 2>/dev/null | cut -f1)
        if [[ -n $remote_head && $remote_head == $head_before ]]; then
          echo "Oh My Zsh is already at the latest version."
          return 0
        fi
      fi
      ZSH="$ZSH" command zsh -f "$ZSH/tools/upgrade.sh" -i -v ${OMZ_UPDATE_VERBOSE:-default} -c $cooldown || return 1
      # Past the interval every run checks again; the stamp moves only when an update landed.
      [[ "$(git -C "$ZSH" rev-parse HEAD 2>/dev/null)" == "$head_before" ]] \
        || echo "LAST_EPOCH=$(( EPOCHSECONDS / 86400 ))" >| "$stamp"
      command rm -rf "$ZSH/log/update.lock" ;;
    omz-plugins)
      # Same interval the autoupdate plugin uses: ':omz:update' frequency (days), passed in
      local stamp="${ZSH_CACHE_DIR:-$HOME/.cache/oh-my-zsh}/.zsh-custom-update" LAST_EPOCH=0
      [[ -f $stamp ]] && . "$stamp"
      if [[ -z "${UPDATE_ALL_FORCE:-}" ]] && (( EPOCHSECONDS / 86400 - ${LAST_EPOCH:-0} <= ${OMZ_UPDATE_DAYS:-13} )); then
        echo "oh-my-zsh custom plugins checked within ${OMZ_UPDATE_DAYS:-13} days, skipping"
        return 0
      fi
      # Past the interval every run checks again; the stamp moves only when a plugin changed.
      local heads_before=$(_update-all-custom-heads)
      upgrade_oh_my_zsh_custom || return 1
      # the autoupdate plugin's own "time to update" reminder keys off this stamp
      [[ "$(_update-all-custom-heads)" == "$heads_before" ]] \
        || echo "LAST_EPOCH=$(( EPOCHSECONDS / 86400 ))" >| "${ZSH_CACHE_DIR:-$HOME/.cache/oh-my-zsh}/.zsh-custom-update" ;;
  esac
}

# Apps built from the user's own repos under ~/dev, each with the script that builds,
# installs and relaunches it. Fast-forwards main and rebuilds only when HEAD moved; a
# repo on another branch, with uncommitted changes, or diverged from origin is left
# untouched and reported.
_update-all-local-builds() {
  local -A builds=(
    hiddenbar-mirror scripts/build-install.zsh
  )
  # The dev root as tools/install.sh finds it: DEV_ROOT (init-global.sh exports it), else the
  # folder holding the tools checkout that ~/bin links into, else ~/dev.
  local root="${DEV_ROOT:-}" link="$HOME/bin/toolbelt"
  [[ -z "$root" && -L "$link" ]] && root="${link:A:h:h:h}"
  root="${root:-$HOME/dev}"
  local name repo before branch rc=0
  for name in ${(ko)builds}; do
    repo="$root/$name"
    [[ -d "$repo/.git" ]] || { echo "$name: no repo at $repo, skipping"; continue; }
    branch=$(git -C "$repo" symbolic-ref --short -q HEAD)
    if [[ "$branch" != main ]]; then
      echo "Action needed: $name is on ${branch:-a detached HEAD}, not main; not pulled"; continue
    fi
    if [[ -n "$(git -C "$repo" status --porcelain)" ]]; then
      echo "Action needed: $name has uncommitted changes; not pulled"; continue
    fi
    before=$(git -C "$repo" rev-parse HEAD)
    if ! git -C "$repo" pull --ff-only -q; then
      echo "Action needed: $name main cannot fast-forward to origin; pull and rebuild by hand"; rc=1; continue
    fi
    if [[ "$(git -C "$repo" rev-parse HEAD)" == "$before" ]]; then
      echo "$name: up to date"; continue
    fi
    echo "$name: pulled ${before:0:7}..$(git -C "$repo" rev-parse --short HEAD), rebuilding"
    ( cd "$repo" && "./${builds[$name]}" ) || { echo "Error: $name build failed; see this stage's log"; rc=1; }
  done
  return $rc
}

# Packages whose update needs a step by hand afterwards, each as "token<TAB>step". They
# are casks that update themselves, so plain `brew upgrade` skips them: uall upgrades
# them (--greedy) and reports the step; upgrading needs no restart, the step comes after.
# Add a row to handle another package.
_update-all-manual-update-steps() {
  print -r -- $'macfuse\treboot, then allow the macFUSE system extension under System Settings > Privacy & Security'
  print -r -- $'karabiner-elements\tre-approve its driver extension if macOS asks (System Settings > Privacy & Security)'
}

# Upgrade the outdated ones among those packages, which `brew upgrade` leaves alone.
_update-all-upgrade-manual-update-casks() {
  local -a outdated=(${${(f)"$(brew outdated --greedy --quiet 2>/dev/null)"}:t}) todo=()
  local line
  for line in "${(@f)$(_update-all-manual-update-steps)}"; do
    (( ${outdated[(Ie)${line%%$'\t'*}]} )) && todo+=(${line%%$'\t'*})
  done
  (( ${#todo} )) || return 0
  brew upgrade --cask --greedy $todo
}

_update-all-report-manual-updates() {
  local brew_log="$1" line token
  local -a outdated=(${${(f)"$(brew outdated --greedy --quiet 2>/dev/null)"}:t})
  for line in "${(@f)$(_update-all-manual-update-steps)}"; do
    token=${line%%$'\t'*}
    if (( ${outdated[(Ie)$token]} )); then
      echo "$token is outdated; update it, then ${line#*$'\t'}"
    elif [[ -f "$brew_log" ]] && grep -qE "^==> Upgrading ${token}"$'\r'"?\$" "$brew_log"; then
      echo "$token was upgraded this run; ${line#*$'\t'}"
    fi
  done
}

_update-all-report-brew-bin() {
  local f
  for f in "$(brew --prefix)"/bin/*(N.*); do
    [[ "${f:t}" == brew ]] && continue
    echo "$f is a regular file, not a Homebrew link"
  done
}

_update-all-report-missing-casks() {
  local token app
  brew info --json=v2 --installed --cask 2>/dev/null \
    | jq -r '.casks[] | .token as $t | .artifacts[] | select(.app) | .app
             | "\($t)\t\(if (.[1]|type)=="object" then .[1].target else (.[0]|split("/")|last) end)"' \
    | while IFS=$'\t' read -r token app; do
        if [[ "$app" == /* ]]; then
          [[ -e "$app" ]] && continue
        else
          [[ -e "/Applications/$app" || -e "$HOME/Applications/$app" ]] && continue
        fi
        echo "$token: $app is not installed"
      done
}

# Right-aligns each dot-separated segment of _uapv_in into its own column across
# every row (e.g. "3.12.5" / "12.4.2" -> " 3.12.5" / "12. 4.2"), into _uapv_out.
# Both arrays are dynamically-scoped locals the caller declares before calling.
_update-all-align-versions() {
  local -a widths=()
  local -a parts
  local n=${#_uapv_in} idx c
  for idx in {1..$n}; do
    parts=("${(@s:.:)_uapv_in[idx]}")
    for c in {1..${#parts}}; do
      (( ${#parts[c]} > ${widths[c]:-0} )) && widths[c]=${#parts[c]}
    done
  done
  _uapv_out=()
  local seg aligned
  for idx in {1..$n}; do
    parts=("${(@s:.:)_uapv_in[idx]}")
    aligned=""
    for c in {1..${#parts}}; do
      seg=$(printf '%*s' ${widths[c]} "${parts[c]}")
      (( c == 1 )) && aligned="$seg" || aligned="${aligned}.${seg}"
    done
    _uapv_out+=("$aligned")
  done
}

# Colors the segments from the first mismatching dot-separated part onward, in
# both numbers, so "1.2.3 -> 1.9.0" reads with only ".9.0"/".2.3" in yellow.
# $1/$2 are the plain (unpadded) pair, used only to find the first difference;
# $3/$4 are the column-aligned pair actually shown, so alignment survives. Sets
# REPLY_A/REPLY_B rather than echoing, since a printf width spec can't see
# through the ANSI codes to know the visible width.
_update-all-highlight-diff() {
  local -a a_parts b_parts aa_parts bb_parts
  a_parts=("${(@s:.:)1}")
  b_parts=("${(@s:.:)2}")
  aa_parts=("${(@s:.:)3}")
  bb_parts=("${(@s:.:)4}")
  local i=1 max=$(( ${#a_parts} > ${#b_parts} ? ${#a_parts} : ${#b_parts} ))
  while (( i <= max )) && [[ "${a_parts[i]:-}" == "${b_parts[i]:-}" ]]; do (( i++ )); done
  local yellow=$'\e[33m' reset=$'\e[0m'
  local a_same="${(j:.:)aa_parts[1,i-1]}" a_diff="${(j:.:)aa_parts[i,-1]}"
  local b_same="${(j:.:)bb_parts[1,i-1]}" b_diff="${(j:.:)bb_parts[i,-1]}"
  [[ -n "$a_same" ]] && a_same+="."
  [[ -n "$b_same" ]] && b_same+="."
  REPLY_A="${a_same}${yellow}${a_diff}${reset}"
  REPLY_B="${b_same}${yellow}${b_diff}${reset}"
}

# Newest release on the pin's own line: the major for node and pnpm, major.minor
# for the rest. asdf's pnpm list includes releases npm tags `next`, so pnpm reads
# the stable latest-<major> tag instead. Prints nothing when the lookup fails.
_update-all-asdf-latest() {
  local tool="$1" ver="$2" line
  case "$tool" in
    nodejs|pnpm) line="${ver%%.*}" ;;
    *)           line="${ver%.*}" ;;
  esac
  if [[ "$tool" == pnpm ]]; then
    npm view pnpm "dist-tags.latest-$line" 2>/dev/null
  else
    asdf latest "$tool" "$line" 2>/dev/null
  fi
}

# True when version $1 is newer than version $2.
_update-all-version-newer() {
  [[ "$1" != "$2" && "$(print -rl -- "$1" "$2" | sort -V | tail -n 1)" == "$1" ]]
}

# Moves each ~/.tool-versions pin to the newest release on its own line: install
# first, re-pin only once the install succeeded, so a failed install leaves the old
# pin and the old version working. A move to a new line (3.12 -> 3.13) is never made
# here, and per-project pins are untouched. Old versions stay installed. dotnet is
# skipped because its newest release on the line can jump SDK feature bands
# (10.0.1xx -> 10.0.4xx) and break a global.json build; java is the system JDK.
# A pin never moves down: a plugin that cannot reach its download host can report
# an old release as the newest. The file is read whole before the loop because
# `asdf set` rewrites it, which would shift a reader still inside it.
_update-all-bump-asdf-pins() {
  local -a manual=(dotnet java)   # a function-local list: the stage's fresh zsh gets functions, not variables
  local tv="$HOME/.tool-versions" line tool ver latest rc=0
  [[ -f "$tv" ]] || return 0
  local -a pins=("${(@f)$(<"$tv")}")
  for line in "${pins[@]}"; do
    read -r tool ver _ <<< "$line"
    [[ -z "$tool" || "$tool" == \#* || "$ver" == system ]] && continue
    (( ${manual[(Ie)$tool]} )) && continue
    latest="$(_update-all-asdf-latest "$tool" "$ver")"
    [[ -n "$latest" && "$latest" != "$ver" ]] || continue
    if ! _update-all-version-newer "$latest" "$ver"; then
      echo "Action needed: asdf reports $latest as the newest $tool on this line, older than the pin $ver; pin left. Check that the $tool plugin can reach its download host"
      continue
    fi
    echo "$tool $ver -> $latest"
    asdf install "$tool" "$latest" && asdf set --home "$tool" "$latest" || {
      echo "Error: could not move $tool from $ver to $latest; pin left at $ver"
      rc=1
    }
  done
  return $rc
}

# Report-only rows: what is still behind after the bump (dotnet, or a failed install).
# Buffers every line before printing so tool names and version segments can be
# column-aligned; the arrows only line up once every row's widths are known.
_update-all-report-asdf-pins() {
  local tv="$HOME/.tool-versions" tool ver latest
  [[ -f "$tv" ]] || return 0
  local -a tools vers latests
  while read -r tool ver _; do
    [[ -z "$tool" || "$tool" == \#* || "$ver" == system ]] && continue
    latest="$(_update-all-asdf-latest "$tool" "$ver")"
    [[ -n "$latest" ]] && _update-all-version-newer "$latest" "$ver" || continue
    tools+=("$tool"); vers+=("$ver"); latests+=("$latest")
  done < "$tv"
  (( ${#tools} )) || return 0

  local -a _uapv_in _uapv_out vers_aligned latests_aligned
  _uapv_in=("${vers[@]}"); _update-all-align-versions; vers_aligned=("${_uapv_out[@]}")
  _uapv_in=("${latests[@]}"); _update-all-align-versions; latests_aligned=("${_uapv_out[@]}")

  local tool_w=0 ver_w=0 t v
  for t in "${tools[@]}"; do (( ${#t} > tool_w )) && tool_w=${#t}; done
  for v in "${vers_aligned[@]}"; do (( ${#v} > ver_w )) && ver_w=${#v}; done

  local idx pad REPLY_A REPLY_B
  for idx in {1..${#tools}}; do
    _update-all-highlight-diff "${vers[idx]}" "${latests[idx]}" "${vers_aligned[idx]}" "${latests_aligned[idx]}"
    pad=$(( ver_w - ${#vers_aligned[idx]} ))
    printf '%-*s %s%*s → %s\n' $tool_w "${tools[idx]}" "$REPLY_A" $pad "" "$REPLY_B"
  done
}

# update-all = "bu, all": brew + pnpm globals + asdf plugins and home pins + uv tools + Mac App Store
# + oh-my-zsh custom plugins (replaces the autoupdate plugin's reminder).
# The asdf stage moves each ~/.tool-versions pin to the newest release on its own line
# (never across a major/minor line, never dotnet or java, per-project pins untouched).
# Each stage runs independently so one failing manager does not skip the rest, and
# under `script` so brew keeps its prompt and colors while the output is logged to
# ~/Library/Logs/update-all/<timestamp>/ (last 10 runs kept). Ends with per-stage
# status, every error line, and read-only reports on drift no stage fixes.
update-all() {
  emulate -L zsh
  setopt no_monitor 2>/dev/null   # no job notices for the background lookups
  zmodload zsh/datetime

  local log_root="$HOME/Library/Logs/update-all"
  local run_dir="$log_root/$(strftime %Y%m%d-%H%M%S $EPOCHSECONDS)"
  mkdir -p "$run_dir" || return 1

  local -a stages=(brew spicetify pnpm asdf uv mas omz omz-plugins local-builds)
  local -A stage_status stage_secs
  local stage start rc watch_pid failed=0 omz_days omz_verbose omz_cooldown
  zstyle -s ':omz:update' frequency omz_days || omz_days=${UPDATE_ZSH_DAYS:-13}
  zstyle -s ':omz:update' verbose omz_verbose || omz_verbose=default
  zstyle -s ':omz:update' cooldown omz_cooldown || omz_cooldown=0
  local mas_sudo=0
  { (( EUID == 0 )) || [[ -t 0 ]] || sudo -n true 2>/dev/null } && mas_sudo=1
  # Functions the stage subshells need, copied in by `typeset -f`. typeset skips a name that is
  # not defined without failing, so a typo here (two names run together) used to surface only as
  # every stage dying with 127. Every required name must be defined before any stage starts;
  # the optional ones come from the omz autoupdate plugin, whose absence skips omz-plugins.
  local -a stage_fns=(
    _mas-signed-in _update-all-mas-upgrade _update-all-stage _update-all-brew-upgrade
    _update-all-manual-update-steps _update-all-upgrade-manual-update-casks
    _update-all-spicetify-reapply _update-all-local-builds
    _pnpm-migrate-globals _pnpm-global-manifests _pnpm-shims-broken _pnpm-fix-shims
    _happy-daemon-refresh _unquarantine-notarized-casks
    _update-all-bump-asdf-pins _update-all-asdf-latest _update-all-asdf-plugins
    _update-all-version-newer
    _update-all-custom-heads
  )
  local -a optional_stage_fns=(_upgrade_custom_plugin upgrade_oh_my_zsh_custom)
  local fn
  local -a missing_fns=()
  for fn in $stage_fns; do (( $+functions[$fn] )) || missing_fns+=($fn); done
  if (( $#missing_fns )); then
    print -u2 "update-all: not defined, so no stage can run: ${(j:, :)missing_fns}"
    print -u2 "  Check the stage_fns list in update-all (~/.zshrc.base) for a typo, then open a new shell."
    return 1
  fi
  for fn in $optional_stage_fns; do (( $+functions[$fn] )) && stage_fns+=($fn); done
  local stage_env="$(typeset -f $stage_fns)"

  # Slow network lookups no stage depends on run alongside the updates.
  softwareupdate -l 2>&1 | sed -n 's/^\* Label: //p' > "$run_dir/report-softwareupdate.txt" &
  local su_pid=$!

  for stage in $stages; do
    if ! { command -v $stage >/dev/null || [[ $stage == local-builds ]] || [[ $stage == omz && -f $ZSH/tools/upgrade.sh ]] || [[ $stage == omz-plugins && -n $functions[upgrade_oh_my_zsh_custom] ]] }; then
      stage_status[$stage]=skipped; stage_secs[$stage]=0
      continue
    fi
    print -P "%B==> $stage%b"
    start=$EPOCHSECONDS
    _update-all-watch-for-question "$run_dir/$stage.log" $stage &
    watch_pid=$!
    # -F: the log is written as the output arrives, which the watcher reads
    script -q -F "$run_dir/$stage.log" zsh -c "$stage_env; zmodload zsh/datetime; export ZSH=${(q)ZSH} ZSH_CUSTOM=${(q)ZSH_CUSTOM} ZSH_CACHE_DIR=${(q)ZSH_CACHE_DIR} OMZ_UPDATE_DAYS=${(q)omz_days} OMZ_UPDATE_VERBOSE=${(q)omz_verbose} OMZ_UPDATE_COOLDOWN=${(q)omz_cooldown} UPDATE_ALL_MAS_SUDO=$mas_sudo; trap 'exit 130' INT; _update-all-stage $stage"
    rc=$?
    kill $watch_pid
    stage_secs[$stage]=$(( EPOCHSECONDS - start ))
    # Ctrl-C reaches the stage through the pty, not this shell: it ends the stage
    # (130) and would otherwise start the next one. Ask whether to go on or quit.
    if (( rc == 130 )); then
      print
      if _update-all-ask-skip $stage; then
        stage_status[$stage]=interrupted
        failed=1
        continue
      fi
      kill $su_pid 2>/dev/null
      print -P "\n%B==> Interrupted during $stage%b  (logs: $run_dir)"
      return 130
    fi
    # 78: the stage skipped its work on purpose and said why (its "Action needed" line lands in the errors below)
    if (( rc == 78 )); then stage_status[$stage]=skipped
    elif (( rc )); then stage_status[$stage]="FAILED ($rc)"; failed=1; else stage_status[$stage]=ok; fi
  done
  wait $su_pid 2>/dev/null
  _update-all-report-asdf-pins > "$run_dir/report-asdf.txt" 2>/dev/null   # after the asdf stage bumped the pins

  print; print -P "%B==> Summary%b"
  local s
  for stage in $stages; do
    s=${stage_secs[$stage]}
    printf '  %-12s %-12s %s\n' $stage "${stage_status[$stage]}" \
      "$( (( s >= 60 )) && echo "$(( s / 60 ))m$(( s % 60 ))s" || echo "${s}s" )"
  done

  # Error lines, from pty logs with color codes and carriage returns stripped
  local e errors=""
  for stage in $stages; do
    [[ -f "$run_dir/$stage.log" ]] || continue
    e="$(sed -e $'s/\x1b\\[[0-9;?]*[A-Za-z]//g' -e $'s/\r//g' "$run_dir/$stage.log" \
      | grep -E "^[[:space:]]*(Error|error|ERR_PNPM|Action needed|Warning: Application '.*' did not quit)")"
    [[ -n "$e" ]] && errors+="  [$stage]"$'\n'"$(print -r -- "$e" | sed 's/^/    /')"$'\n'
  done
  [[ -n "$errors" ]] && { print; print -P "%B==> Needs attention%b"; print -rn -- "$errors" }

  local -a titles=(
    "Updates to finish by hand"
    "Regular files in the brew bin dir"
    "Casks with a missing app"
    "asdf pins behind their line"
    "Unneeded brew formulae"
    "Pending macOS updates"
  )
  local -a bodies=(
    "$(_update-all-report-manual-updates "$run_dir/brew.log")"
    "$(_update-all-report-brew-bin)"
    "$(_update-all-report-missing-casks)"
    "$(<"$run_dir/report-asdf.txt")"
    "$(brew autoremove -n 2>/dev/null | grep -v '^==>')"
    "$(<"$run_dir/report-softwareupdate.txt")"
  )
  local i shown=0
  for i in {1..${#titles}}; do
    [[ -n "${bodies[$i]}" ]] || continue
    (( shown++ )) || { print; print -P "%B==> Reports%b" }
    print "  ${titles[$i]}:"
    print -r -- "${bodies[$i]}" | sed 's/^/    /'
  done

  print; print "Logs: $run_dir"

  # Copy this run's upgrades into upgrades.tsv beside the logs, which the pruning
  # below leaves alone, so upgrade history outlives the last 10 runs.
  (( $+commands[find-unused-packages] )) && find-unused-packages --ingest "$run_dir"

  # Run dirs are timestamps, so name order is age order.
  local -a runs=("$log_root"/*(N/on))
  while (( ${#runs} > 10 )); do
    rm -rf -- "${runs[1]}"
    shift runs
  done

  return $failed
}

# ─── Aliases: Git ───────────────────────────────────────────────────────────────
# fancy git log
alias gitlog="git log --graph --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%an%C(reset)%C(bold yellow)%d%C(reset) %C(dim white)- %s%C(reset)' --all"

# https://github.com/peterhurford/git-it-on.zsh
alias gitito="gitit branch main"

# ─── Aliases: Utilities ─────────────────────────────────────────────────────────
alias history="history 1"           # history size fix
alias python='python3'
alias bu='brew update && brew upgrade'
alias uall='update-all'
alias chrome="open -a 'Google Chrome'"

# Claude-in-Chrome: open the browser in this config folder's Chrome profile. Active only where
# agents/claude/chrome-open-shim/install.sh has been run; otherwise claude runs unchanged.
claude() {
  local shim="$HOME/.local/share/claude-open-shim"
  if [[ -x $shim/open ]]; then PATH="$shim:$PATH" command claude "$@"; else command claude "$@"; fi
}
alias zshconfig="subl $HOME/.zshrc"
alias wifi-list='get_wifi_networks'

# show all files in a tree structure (works with ls zsh plugin)
alias lta="lt -a"

# show all files whose names begin with '.' except . and ..
alias lsa="ls -A"

# tailscale cli
alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"

# ─── iTerm2 Helpers ──────────────────────────────────────────────────────────
# Set iTerm2 tab color (RGB 0-255)
# Usage: iterm_tab_color 80 120 200
function iterm_tab_color() {
  [[ "$TERM_PROGRAM" == "iTerm.app" ]] || return 0
  printf "\e]6;1;bg;red;brightness;%d\a\e]6;1;bg;green;brightness;%d\a\e]6;1;bg;blue;brightness;%d\a" "$1" "$2" "$3" 2>/dev/null
  return 0
}

# Set iTerm2 tab title (disables oh-my-zsh auto title for this session)
# Usage: iterm_tab_title "My Tab"
function iterm_tab_title() {
  [[ "$TERM_PROGRAM" == "iTerm.app" ]] || return 0
  DISABLE_AUTO_TITLE=true
  print -Pn "\e]1;$1\a" 2>/dev/null
  return 0
}

# Reset iTerm2 tab color to default
function iterm_tab_color_reset() {
  [[ "$TERM_PROGRAM" == "iTerm.app" ]] || return 0
  echo -e "\033]6;1;bg;*;default\007" 2>/dev/null
  return 0
}

# ─── Hooks ──────────────────────────────────────────────────────────────────────
autoload -Uz add-zsh-hook
add-zsh-hook preexec notify_on_password_prompt
