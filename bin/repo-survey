#!/bin/zsh
# DESC: Survey every git repo under a directory — fetch, then report ahead/behind and working-tree dirt
#
# Read-only: fetches from each remote and reports. Never merges, rebases, or resets.
#
# Usage:
#   repo-survey [root]     # defaults to the current directory
#   repo-survey --help
#
# Exit status is 1 if any repo is behind, diverged, or dirty — so it can gate a script.

set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi

# Root is an argument or the current directory — never a baked-in path.
ROOT="${1:-$PWD}"
[[ -d "$ROOT" ]] || { print -u2 "repo-survey: not a directory: $ROOT"; exit 2 }

printf '%-24s %-10s %6s %6s  %s\n' REPO BRANCH AHEAD BEHIND STATE
printf '%-24s %-10s %6s %6s  %s\n' ------ ------ ----- ------ -----

problems=0

for dir in "$ROOT"/*(N/); do
    [[ -e "$dir/.git" ]] || continue
    name="${dir:t}"

    git -C "$dir" fetch -q --all 2>/dev/null || true
    branch="$(git -C "$dir" branch --show-current)"

    # A missing upstream is itself a finding, and such a repo still needs its dirt
    # reported — skipping it here once hid a repo whose entire source was untracked.
    if upstream="$(git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"; then
        counts="$(git -C "$dir" rev-list --left-right --count "${branch}...${upstream}" 2>/dev/null)"
        ahead="${counts%%	*}"
        behind="${counts##*	}"
        no_upstream=0
    else
        ahead=- ; behind=- ; no_upstream=1
    fi

    dirt=()
    (( no_upstream )) && dirt+=("NO REMOTE")
    git -C "$dir" diff --quiet 2>/dev/null            || dirt+=(dirty)
    git -C "$dir" diff --cached --quiet 2>/dev/null   || dirt+=(staged)
    [[ -n "$(git -C "$dir" ls-files --others --exclude-standard | head -1)" ]] && dirt+=(untracked)
    (( ${#dirt} )) || dirt=(clean)

    printf '%-24s %-10s %6s %6s  %s\n' "$name" "$branch" "$ahead" "$behind" "${dirt[*]}"

    # NB: plain assignment, not (( problems++ )) — post-increment evaluates to the
    # old value, so the first bump returns 0 and set -e kills the loop.
    if (( no_upstream )) || (( behind > 0 || ahead > 0 )) || [[ "${dirt[1]}" != clean ]]; then
        problems=$(( problems + 1 ))
    fi
done

(( problems == 0 )) || exit 1
