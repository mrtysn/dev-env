#!/bin/zsh
# DESC: Drive the OJ boot config from anywhere — no arguments opens the launcher GUI
#
# A thin front for <oj-repo>/tools/ojctl.py, which decides what an OJ game
# project boots. Every argument is passed straight through, so this is the same
# tool with a shorter name and no need to be standing in the repo:
#
#   ojctl                     open the launcher GUI
#   ojctl show                what boots right now
#   ojctl set --game moji     boot straight into one game
#   ojctl set --chooser       show the chooser instead
#   ojctl history             recent runs, boot changes and deploys
#
# The repo path is machine state, so it is never baked in here — this file syncs
# to every machine and the repo sits somewhere different on each. It is resolved
# in the order below, and `oj-repo/tools/install_shortcut.sh` writes the config.

set -euo pipefail

resolve_repo() {
	# 1. An explicit override, for a second checkout.
	if [[ -n "${OJ_REPO:-}" ]]; then
		print -r -- "$OJ_REPO"
		return
	fi
	# 2. The repo you are standing in, so a checkout that was never installed
	#    still works from inside itself.
	local top
	if top=$(git rev-parse --show-toplevel 2>/dev/null) && [[ -x "$top/tools/ojctl.py" ]]; then
		print -r -- "$top"
		return
	fi
	# 3. The installed path — the only one that works from a GUI or another
	#    directory entirely.
	local config="${XDG_CONFIG_HOME:-$HOME/.config}/oj/repo"
	[[ -r "$config" ]] || return 1
	print -r -- "$(<"$config")"
}

if ! repo=$(resolve_repo) || [[ ! -x "$repo/tools/ojctl.py" ]]; then
	print -u2 "ojctl: no oj repo configured."
	print -u2 "Run tools/install_shortcut.sh from the repo, or set OJ_REPO."
	exit 1
fi

# Bare invocation opens the GUI: this command exists so the launcher is one word.
(( $# )) || set -- gui

exec "$repo/tools/ojctl.py" "$@"
