# C03 · Work Mac (mrtysn-mbp-m5) — machine-specific dependencies.
# Apps the employer installs through its own portal are not listed here.
# Development
brew "bun"                      # JavaScript runtime and package manager
brew "mise"                     # runtime version manager
# Access
cask "gcloud-cli"               # Google Cloud CLI
cask "okta-verify"              # Okta sign-in approvals
cask "1password"                # password manager
# Communication
cask "slack"                    # team chat
# Meetings
cask "granola"                  # meeting notes
# Issue tracking
cask "linear"                   # Linear desktop app; updates itself
# Everyday
cask "chatgpt"                  # ChatGPT desktop app
cask "shottr"                   # screenshot tool
# Editors
cask "visual-studio-code"       # editor; this Mac only, Sublime is the editor elsewhere
