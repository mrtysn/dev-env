# ─── dev-env loader ─────────────────────────────────────────────────────────────
# Thin entrypoint. Sources the shared base, then this machine's config.
# Managed by the dev-env repo (import.sh / export.sh).
#   • Shared changes        → edit ~/.zshrc.base
#   • Machine-specific ones → edit ~/.zshrc.<label> (c02 Home, c03 Work)
# Keep p10k's instant-prompt block (top of ~/.zshrc.base) first: nothing above it
# may write to the console.

[[ -f ~/.zshrc.base ]] && source ~/.zshrc.base

# Machine detection: ~/.zshrc.label (one line, "c02" or "c03") wins when present. It stays on
# the machine, never in this repo, for a Mac whose name an MDM sets. Otherwise LocalHostName —
# `hostname -s` is unreliable on some LANs (it can resolve to a DHCP name like "192").
case "$(cat ~/.zshrc.label 2>/dev/null || scutil --get LocalHostName 2>/dev/null || hostname -s)" in
  c02|mrtysn-mbp-m2max)  [[ -f ~/.zshrc.c02 ]] && source ~/.zshrc.c02 ;;  # C02 · Home
  c03|mrtysn-mbp-m5)     [[ -f ~/.zshrc.c03 ]] && source ~/.zshrc.c03 ;;  # C03 · Work
esac

# Added by LM Studio CLI (lms)
export PATH="$PATH:$HOME/.cache/lm-studio/bin"
# End of LM Studio CLI section

