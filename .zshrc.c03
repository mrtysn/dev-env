# C03 · Work Mac (mrtysn-mbp-m5) — machine-specific shell config. Empty until the machine needs some.

# Volta: Node and pnpm per project, read from each repo's package.json.
# VOLTA_FEATURE_PNPM makes Volta manage pnpm, which a repo's packageManager field pins.
export VOLTA_HOME="$HOME/.volta"
export VOLTA_FEATURE_PNPM=1
export PATH="$VOLTA_HOME/bin:$PATH"
