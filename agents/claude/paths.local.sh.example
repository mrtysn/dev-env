# Machine-local paths for hook commands in settings.json.
#
# Written by import.sh step 12, or on demand by write-paths-local.sh in this
# directory. This example is the shape; the filled-in copy stays out of git —
# ~/.claude is not a repo and export.sh reads only settings.json.
#
# Hook commands source this file and exit 2 — blocking the tool call — when a
# path it should define is missing.

# Checkout of the agents-shared repo, which holds hooks/ and claude/rules/.
# Whatever this machine actually uses, e.g. $HOME/dev/agents-shared or
# $HOME/src/agents-shared or $HOME/work/tools/agents-shared.
AGENTS_SHARED_DIR="$HOME/path/to/agents-shared"
